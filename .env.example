# ==============================================================================
# Tundenxin — Gatekeeper Verification System Configuration
# ==============================================================================

# Server settings
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000

# Secret key used for signing session cookies (Change this to a random 64+ char string)
SESSION_SECRET=tx_secret_salt_replace_with_a_secure_random_string_for_production_use

# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# Tạo bot tại @BotFather trên Telegram và dán token vào đây:
TELEGRAM_BOT_TOKEN=
# Username của bot (không có ký tự @, ví dụ: TundenxinVerifyBot):
TELEGRAM_BOT_USERNAME=
# Chat ID của nhóm Telegram cần xác minh thành viên (bắt đầu bằng -100...):
# Để lấy Chat ID: Thêm bot vào nhóm và gửi tin nhắn, hoặc dùng bot @userinfobot / @raw_data_bot
TELEGRAM_CHAT_ID=
# Link nhóm chính thức để người dùng tham gia:
TELEGRAM_GROUP_LINK=https://t.me/BoxToolGS_VN

# ==============================================================================
# Discord Configuration (Để trống nếu chỉ sử dụng Telegram)
# ==============================================================================
# Tạo ứng dụng tại Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Server ID (Guild ID) cần kiểm tra thành viên:
DISCORD_GUILD_ID=
# Link mời tham gia server:
DISCORD_SERVER_LINK=https://discord.gg/xa83TbAw6n
# Redirect URI (Phải khớp với cấu hình trong OAuth2 Redirects của Discord Developer Portal):
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# ==============================================================================
# Token & Security Expiration Times (in seconds)
# ==============================================================================
# Thời hạn hiệu lực của mã liên kết tài khoản (mặc định 10 phút = 600 giây)
LINK_TOKEN_EXPIRE_SECONDS=600
# Thời hạn hiệu lực của token tải file sau khi đã xác minh (mặc định 5 phút = 300 giây)
DOWNLOAD_TOKEN_EXPIRE_SECONDS=300
